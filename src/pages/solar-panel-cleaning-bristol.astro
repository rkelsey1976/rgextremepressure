---
// /solar-panel-cleaning-bristol/ — city money page for solar panel cleaning.
//
// Added 2026-10-11. Bristol twin of the Bath page — follows the twin diff
// pattern from the Bristol fascia launch: phone-first hero CTA, a coverage
// FAQ listing the BS districts, areaServed narrowed to Bristol, Bristol
// cross-links. No before/after photo sections (no solar job photography
// exists — same honesty note as the Bath page).
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ImageCTA from '../components/ImageCTA.astro';
import TrustMetrics from '../components/TrustMetrics.astro';

const title = 'Solar Panel Cleaning Bristol';
const description = 'Professional solar panel cleaning across Bristol (BS1–BS16). Soft-bristle pole cleaning for rooftop arrays — bird droppings, pollen film and lichen removed, glass never walked on. Rated 5.0 from 113 Google reviews. Call 07474 939 398.';

const faqs = [
  {
    q: 'Do you clean solar panels across all Bristol postcodes?',
    a: 'Yes. We cover all Bristol postcodes from BS1 to BS16, including Clifton, Redland, Bishopston, Henleaze, Kingswood, Fishponds, Brislington, Bedminster, Downend, Westbury-on-Trym and surrounding areas. No extra travel charge anywhere in the Bristol and Bath corridor.'
  },
  {
    q: 'Will cleaning improve the output of my panels?',
    a: 'If the glass is visibly soiled, yes — that is what the dirt is doing, blocking light. A bird dropping can shade a disproportionate share of an individual panel because of how the cell strings work. We will not promise a percentage gain before we have looked at the array — but visible droppings and lichen are recoverable generation.'
  },
  {
    q: 'Do you walk on the roof to reach the panels?',
    a: 'No. Cleaning is done with long-reach poles and soft-bristle heads from the ground or roof edge. Walking on solar glass risks micro-cracks in the cells and falls outside what most panel warranties expect — so we do not do it.'
  },
  {
    q: 'Can you combine solar cleaning with gutter clearing?',
    a: "Absolutely — and we'd recommend it before winter. Since we're already working on the same roofline, one visit can take in the gutters, the glass and the frames. It is nearly always cheaper than two separate call-outs."
  },
  {
    q: 'Can older Bristol arrays with lichen be cleaned?',
    a: 'Yes. A lot of Bristol arrays date from the feed-in-tariff years and have lichen spreading in from the panel edges. Bonded growth comes off slowly and gently with soft bristles — never scraped or jetted — and the glass underneath still works. It is a slower clean, and the quote reflects that honestly.'
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Solar Panel Cleaning Bristol",
  "description": description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "RG Extreme Pressure",
    "telephone": "07474 939 398",
    "address": { "@type": "PostalAddress", "addressLocality": "Bath", "addressRegion": "Somerset" }
  },
  "areaServed": { "@type": "City", "name": "Bristol" },
};
---

<Base {title} {description} serviceSchema={serviceSchema} faqSchema={faqSchema} breadcrumbs={[
  { name: 'Solar Panel Cleaning Bristol', item: 'https://rgextremepressure.co.uk/solar-panel-cleaning-bristol' }
]}>
  <Hero
    image="/images/solar/solar-hero-1.webp"
    overlay="blue"
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Solar Panel Cleaning Bristol' }]}
    eyebrow="Professional Solar Panel Cleaning"
    heading="Solar Panel Cleaning Bristol"
    body="Rooftop solar arrays quietly lose output to what lands on them — bird droppings, pollen film, leaf litter, lichen. We clean the glass the safe way: soft-bristle heads on long-reach poles, from the ground, with nobody walking on your panels. Covers all BS1–BS16 postcodes."
    cta={{ label: 'Call 07474 939 398', href: 'tel:07474939398' }}
    ctaSecondary={{ label: 'Get a Free Quote', href: '/contact' }}
    minHeight="compact"
  />

  <TrustMetrics metrics={[
    { value: '113', label: 'Google Reviews' },
    { value: '10', label: 'Years Experience' },
    { value: 'Insured', label: 'Fully Insured' },
    { value: 'Free', label: 'Free Quotes' },
  ]} />

  <section class="service-body">
    <div class="container">
      <div class="service-body__grid">
        <div class="service-body__main">
          <SectionHeader
            eyebrow="What We Do"
            heading="Specialist Solar Panel Cleaning in Bristol"
