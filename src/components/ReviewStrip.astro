---
// ReviewStrip.astro — genuine Google reviews on the service pages.
//
// Every review here is real, transcribed from the GBP profile, and always shows
// its true location. Nothing is re-attributed to the page's city.
import { reviewsForPage } from '../data/reviews';

interface Props {
  /** Keywords matched against the review's service text, e.g. ['gutter'] */
  keywords: string[];
  /** Page city — matching reviews from here are shown first */
  city?: string;
  heading?: string;
  limit?: number;
}

const { keywords, city, heading = 'What Customers Say', limit = 3 } = Astro.props;
const reviews = reviewsForPage(keywords, city, limit);
---

{reviews.length > 0 && (
  <section class="review-strip">
    <div class="container">
      <div class="review-strip__head">
        <span class="review-strip__label">Google Reviews</span>
        <h2 class="review-strip__heading">{heading}</h2>
        <p class="review-strip__sub">113 five-star reviews on Google. A few of them below.</p>
      </div>
      <div class="review-strip__grid">
        {reviews.map(r => (
          <blockquote class="review-card">
            <div class="review-card__stars" aria-label={`${r.stars} out of 5 stars`}>
              {Array.from({ length: r.stars }).map(() => (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <p class="review-card__quote">{r.quote}</p>
            <footer class="review-card__meta">
              <cite class="review-card__name">{r.name}</cite>
              <span class="review-card__detail">{r.service}{r.location ? ` · ${r.location}` : ''}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .review-strip { padding: var(--section-pad) 0; background: var(--accent-light); }
  .review-strip__head { margin-bottom: var(--space-xl); }
  .review-strip__label { display: inline-block; font-family: var(--font-body); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: var(--space-s); }
  .review-strip__heading { font-family: var(--font-display); font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 800; line-height: 1.15; color: var(--chalk); margin: 0 0 0.4rem; }
  .review-strip__sub { font-size: 0.92rem; color: var(--concrete); margin: 0; }

  .review-strip__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-l); }

  .review-card { background: #fff; border-radius: var(--radius, 8px); padding: var(--space-l); margin: 0; display: flex; flex-direction: column; gap: var(--space-s); border-top: 3px solid var(--accent); }
  .review-card__stars { display: flex; gap: 0.1rem; color: #f5a623; }
  .review-card__quote { font-size: 0.92rem; font-weight: 300; line-height: 1.7; color: var(--concrete); margin: 0; flex: 1; }
  .review-card__meta { display: flex; flex-direction: column; gap: 0.15rem; margin-top: auto; }
  .review-card__name { font-family: var(--font-display); font-size: 0.95rem; font-weight: 800; font-style: normal; color: var(--chalk); }
  .review-card__detail { font-size: 0.78rem; color: var(--concrete); opacity: 0.8; }

  @media (max-width: 640px) {
    .review-strip__grid { grid-template-columns: 1fr; }
  }
</style>
